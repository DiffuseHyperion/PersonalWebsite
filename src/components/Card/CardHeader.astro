---
const {title, href = undefined} = Astro.props;
---

<div class="flex flex-row justify-between">
    {href ? <a class="underline text-accent cursor-pointer text-2xl font-bold" href={href}>{title}</a> :
            <h3 class="text-3xl font-bold">{title}</h3>}
    <div class="flex flex-row gap-x-2">
        <slot/>
    </div>
</div>